* {
  bg: #24273acc;
  mantle: #1e2030f2;
  surface: #363a4ff2;
  surface2: #494d64f2;
  text: #cad3f5;
  muted: #a5adcb;
  accent: #8aadf4;
  lavender: #b7bdf8;
  red: #ed8796;

  font: "JetBrainsMono Nerd Font 13";
}

window {
  width: 44%;
  border: 2px;
  border-color: @accent;
  border-radius: 8px;
  background-color: @bg;
}

mainbox {
  padding: 16px;
  spacing: 12px;
  background-color: transparent;
}

inputbar {
  children: [ prompt, entry ];
  padding: 11px 12px;
  spacing: 10px;
  border-radius: 7px;
  background-color: @surface;
}

prompt {
  text-color: @accent;
}

entry {
  placeholder: "Search";
  placeholder-color: @muted;
  text-color: @text;
}

message {
  padding: 10px;
  border-radius: 7px;
  background-color: @surface;
  text-color: @text;
}

listview {
  lines: 10;
  columns: 1;
  spacing: 6px;
  fixed-height: true;
  background-color: transparent;
}

element {
  padding: 9px 10px;
  spacing: 10px;
  border-radius: 7px;
  background-color: transparent;
  text-color: @muted;
}

element selected {
  background-color: @accent;
  text-color: @mantle;
}

element urgent {
  text-color: @red;
}

element-icon {
  size: 24px;
  background-color: transparent;
}

element-text {
  vertical-align: 0.5;
  background-color: transparent;
}

mode-switcher {
  spacing: 6px;
}

button {
  padding: 8px 10px;
  border-radius: 7px;
  background-color: @surface;
  text-color: @muted;
}

button selected {
  background-color: @surface2;
  text-color: @lavender;
}
